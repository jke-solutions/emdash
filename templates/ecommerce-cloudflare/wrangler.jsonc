{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-emdash-ecommerce",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [{ "binding": "DB", "database_name": "my-emdash-ecommerce" }],
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "my-emdash-ecommerce-media" }],
	"worker_loaders": [{ "binding": "LOADER" }],
	"triggers": { "crons": ["* * * * *", "*/2 * * * *"] }
}
