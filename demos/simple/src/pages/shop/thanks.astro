---
import Base from "../../layouts/Base.astro";
---

<Base title="Pedido recibido" description="Hemos recibido tu pedido.">
	<main class="order-page">
		<p class="eyebrow">Gracias</p>
		<h1>Pedido recibido</h1>
		<p>Tu pedido se registró correctamente. Guarda el número de pedido para consultar su estado.</p>
		<section class="order-card" id="order-card">
			<p>Cargando los detalles del pedido…</p>
		</section>
		<nav class="order-actions">
			<a href="/shop/track">Rastrear otro pedido</a>
			<a href="/shop">Continuar comprando</a>
		</nav>
	</main>
</Base>

<script is:inline>
	const orderCard = document.querySelector("#order-card");
	const orderNumber = new URLSearchParams(window.location.search).get("order");
	const labels = { new: "Recibido", confirmed: "Confirmado", preparing: "Preparando", ready: "Listo para entrega", in_transit: "En entrega", delivered: "Entregado", cancelled: "Cancelado", pending: "Pendiente" };
	const money = (value, symbol) => `${symbol} ${new Intl.NumberFormat(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(value)}`;

	const renderOrder = (order) => {
		orderCard.replaceChildren();
		const title = document.createElement("h2");
		title.textContent = `Pedido ${order.orderNumber}`;
		const status = document.createElement("p");
		status.textContent = `Estado: ${labels[order.status] ?? order.status} · Pago: ${labels[order.paymentStatus] ?? order.paymentStatus} · Entrega: ${labels[order.deliveryStatus] ?? order.deliveryStatus}`;
		orderCard.append(title, status);
		for (const item of order.items) {
			const row = document.createElement("div");
			row.className = "order-item";
			if (item.imageUrl) { const image = document.createElement("img"); image.src = item.imageUrl; image.alt = item.productName; row.append(image); }
			const text = document.createElement("p");
			text.textContent = `${item.productName} × ${item.quantity} — ${money(item.subtotal, order.currencySymbol)}`;
			row.append(text);
			orderCard.append(row);
		}
		const total = document.createElement("strong");
		total.textContent = `Total: ${money(order.total, order.currencySymbol)}`;
		orderCard.append(total);
		if (order.whatsappUrl) {
			const whatsapp = document.createElement("a");
			whatsapp.className = "whatsapp-link";
			whatsapp.href = order.whatsappUrl;
			whatsapp.target = "_blank";
			whatsapp.rel = "noreferrer";
			whatsapp.textContent = "Coordinar pago por WhatsApp";
			orderCard.append(whatsapp);
		}
	};

	if (!orderNumber) orderCard.textContent = "No se proporcionó el número de pedido.";
	else fetch(`/_emdash/api/shop/orders/${encodeURIComponent(orderNumber)}`).then((response) => response.json().then((body) => ({ response, body }))).then(({ response, body }) => {
		if (!response.ok) throw new Error(body?.error?.message ?? "No se encontró el pedido.");
		renderOrder(body.data);
		return null;
	}).catch((error) => { orderCard.textContent = error instanceof Error ? error.message : "No se pudo cargar el pedido."; });
</script>

<style>
	.order-page { max-width: 720px; margin: 0 auto; padding: var(--spacing-16) var(--spacing-6); }
	.eyebrow { color: var(--color-accent); font-size: var(--font-size-sm); font-weight: 700; text-transform: uppercase; }
	.order-page > p:not(.eyebrow) { color: var(--color-text-secondary); }
	.order-card { display: grid; gap: var(--spacing-3); margin-top: var(--spacing-8); padding: var(--spacing-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
	.order-card p { margin: 0; padding-bottom: var(--spacing-3); border-bottom: 1px solid var(--color-border); }
	.order-item { display: flex; align-items: center; gap: var(--spacing-3); padding-bottom: var(--spacing-3); border-bottom: 1px solid var(--color-border); }
	.order-item p { padding: 0; border: 0; }
	.order-item img { width: 64px; height: 64px; border-radius: var(--radius); object-fit: contain; background: var(--color-bg-subtle); }
	.order-card strong { font-size: var(--font-size-xl); }
	.whatsapp-link { display: inline-block; margin-top: var(--spacing-3); padding: var(--spacing-3) var(--spacing-4); border-radius: var(--radius); background: var(--color-accent); color: var(--color-on-accent); font-weight: 700; text-align: center; text-decoration: none; }
	.order-actions { display: flex; gap: var(--spacing-5); margin-top: var(--spacing-6); }
	.order-actions a { color: var(--color-accent); }
</style>
