---
import Base from "../../layouts/Base.astro";
---

<Base title="Finalizar compra" description="Completa tus datos de entrega y coordina tu pedido por WhatsApp.">
	<main class="checkout-page">
		<a class="back-link" href="/shop">← Volver a la tienda</a>
		<header>
			<p class="eyebrow">Detalles del pedido</p>
			<h1>Finalizar compra</h1>
			<p>Completa tus datos de entrega. El pago se coordinará por WhatsApp.</p>
		</header>
		<div class="checkout-layout">
			<section class="checkout-summary">
				<h2>Tu pedido</h2>
				<div id="checkout-items">Cargando pedido…</div>
				<strong id="checkout-total"></strong>
			</section>
			<form id="checkout-form" class="checkout-form">
				<h2 id="delivery-heading">Datos de entrega</h2>
				<div id="saved-customer" class="saved-customer" hidden>
					<p>Encontramos tus datos de entrega anteriores en este dispositivo.</p>
					<div class="saved-customer-actions">
						<button type="button" id="use-saved-customer" class="secondary-button">Usar datos guardados</button>
						<button type="button" id="clear-saved-customer" class="text-button">Usar otros datos</button>
					</div>
				</div>
				<label>Nombre <input name="name" required /></label>
				<label>Teléfono <input name="phone" required /></label>
				<label>Correo electrónico <input name="email" type="email" /></label>
				<label data-delivery-field>Dirección <input name="address" required /></label>
				<label data-delivery-field>Distrito <input name="district" required /></label>
				<label data-delivery-field>Referencia <input name="reference" /></label>
				<label data-delivery-field>Zona de entrega <select name="deliveryZoneId" required id="delivery-zone"></select></label>
				<label>Método de pago <select name="paymentMethod" required id="payment-method"></select></label>
				<div class="coupon-box">
					<label>Código de descuento <input name="couponCode" id="coupon-code" autocomplete="off" /></label>
					<button type="button" id="apply-coupon" class="secondary-button">Aplicar cupón</button>
					<p id="coupon-message" role="status"></p>
				</div>
				<label>Notas <textarea name="notes"></textarea></label>
				<button type="submit">Crear pedido y continuar a WhatsApp</button>
				<p id="checkout-message" role="status"></p>
			</form>
		</div>
	</main>
</Base>

<script is:inline>
	const storageKey = "emdash-shop-cart";
	const customerStorageKey = "emdash-shop-customer";
	const apiBase = "/_emdash/api/shop";
	const itemsElement = document.querySelector("#checkout-items");
	const totalElement = document.querySelector("#checkout-total");
	const form = document.querySelector("#checkout-form");
	const zonesElement = document.querySelector("#delivery-zone");
	const paymentElement = document.querySelector("#payment-method");
	const messageElement = document.querySelector("#checkout-message");
	const savedCustomerElement = document.querySelector("#saved-customer");
	const couponCodeElement = document.querySelector("#coupon-code");
	const applyCouponButton = document.querySelector("#apply-coupon");
	const couponMessageElement = document.querySelector("#coupon-message");
	const useSavedCustomerButton = document.querySelector("#use-saved-customer");
	const clearSavedCustomerButton = document.querySelector("#clear-saved-customer");
	let cart = [];
	let settings = { currency: "PEN", currencySymbol: "S/", paymentMethods: ["whatsapp"] };
	let cartSubtotal = 0;
	let appliedCoupon = null;
	const paymentMethodLabels = {
		whatsapp: "WhatsApp",
		yape: "Yape",
		plin: "Plin",
		bank_transfer: "Transferencia bancaria",
		cash_on_delivery: "Pago contra entrega",
	};

	try {
		const stored = JSON.parse(localStorage.getItem(storageKey) ?? "[]");
		if (Array.isArray(stored)) {
			cart = stored
				.filter((entry) => entry?.product && Number.isInteger(entry.quantity) && entry.quantity > 0)
				.map((entry) => {
					const itemType = entry.product?.data?.item_type ?? entry.product?.data?.itemType;
					const isService = entry.booking || entry.product?.isBookableService || (typeof itemType === "string" && itemType.toLowerCase() === "service");
					return isService ? { ...entry, quantity: 1 } : entry;
				});
			localStorage.setItem(storageKey, JSON.stringify(cart));
		}
	} catch {
		cart = [];
	}

	if (cart.length === 0) window.location.replace("/shop");
	const hasPhysicalItems = cart.some((entry) => {
		const itemType = entry.product?.data?.item_type ?? entry.product?.data?.itemType;
		const isService = entry.booking || entry.product?.isBookableService || (typeof itemType === "string" && itemType.toLowerCase() === "service");
		return !isService;
	});
	if (!hasPhysicalItems) {
		document.querySelectorAll("[data-delivery-field]").forEach((field) => {
			if (field instanceof HTMLElement) field.hidden = true;
			field.querySelectorAll("[required]").forEach((input) => input.removeAttribute("required"));
		});
		const deliveryHeading = document.querySelector("#delivery-heading");
		if (deliveryHeading) deliveryHeading.textContent = "Datos de contacto";
		const checkoutDescription = document.querySelector(".checkout-page header p:last-child");
		if (checkoutDescription) checkoutDescription.textContent = "Completa tus datos de contacto para confirmar la reserva.";
	}

	const customerFields = ["name", "phone", "email", "address", "district", "reference"];
	let savedCustomer = null;
	try {
		const storedCustomer = JSON.parse(localStorage.getItem(customerStorageKey) ?? "null");
		if (storedCustomer && typeof storedCustomer === "object" && typeof storedCustomer.name === "string" && typeof storedCustomer.phone === "string") savedCustomer = storedCustomer;
	} catch {
		savedCustomer = null;
	}

	const fillCustomerForm = (customer) => {
		for (const field of customerFields) {
			const input = form?.elements.namedItem(field);
			if (input && "value" in input) input.value = customer[field] ?? "";
		}
	};
	if (savedCustomerElement && savedCustomer) savedCustomerElement.hidden = false;
	useSavedCustomerButton?.addEventListener("click", () => {
		if (savedCustomer) fillCustomerForm(savedCustomer);
		if (savedCustomerElement) savedCustomerElement.hidden = true;
	});
	clearSavedCustomerButton?.addEventListener("click", () => {
		localStorage.removeItem(customerStorageKey);
		savedCustomer = null;
		if (savedCustomerElement) savedCustomerElement.hidden = true;
	});

	const money = (value) => `${settings.currencySymbol} ${new Intl.NumberFormat(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(value)}`;
	const productPrice = (entry) => {
		const variant = Array.isArray(entry.product.data?.variants) ? entry.product.data.variants.find((item) => (item.id ?? item.label) === entry.variantId) : null;
		if (typeof variant?.price === "number" && variant.price >= 0) return variant.price;
		const regular = Number(entry.product.data?.price ?? 0);
		const promotion = Number(entry.product.data?.promotion_price ?? regular);
		return promotion >= 0 && promotion < regular ? promotion : regular;
	};

	const renderSummary = () => {
		itemsElement?.replaceChildren();
		let total = 0;
		for (const entry of cart) {
			const name = entry.product.data?.name ?? entry.product.slug ?? "Producto";
			const variant = Array.isArray(entry.product.data?.variants) ? entry.product.data.variants.find((item) => (item.id ?? item.label) === entry.variantId) : null;
			const row = document.createElement("p");
			const subtotal = productPrice(entry) * entry.quantity;
			row.textContent = `${name}${variant?.label ? ` (${variant.label})` : ""} × ${entry.quantity} — ${money(subtotal)}`;
			itemsElement?.append(row);
			 total += subtotal;
		}
		cartSubtotal = total;
		const couponDiscount = appliedCoupon?.discount ?? 0;
		if (totalElement) totalElement.textContent = couponDiscount > 0 ? `Subtotal: ${money(total)} · Descuento: -${money(couponDiscount)} · Total: ${money(total - couponDiscount)}` : `Total: ${money(total)}`;
	};

	applyCouponButton?.addEventListener("click", async () => {
		const code = couponCodeElement?.value.trim() ?? "";
		if (!code) { if (couponMessageElement) couponMessageElement.textContent = "Ingresa un código de descuento."; return; }
		if (applyCouponButton instanceof HTMLButtonElement) applyCouponButton.disabled = true;
		try {
			const response = await fetch(`${apiBase}/coupons/validate`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ code, subtotal: cartSubtotal }) });
			const body = await response.json();
			if (!response.ok) throw new Error(body?.error?.message ?? "El cupón no es válido.");
			appliedCoupon = body.data;
			if (couponMessageElement) couponMessageElement.textContent = `Cupón ${appliedCoupon.code} aplicado.`;
			renderSummary();
		} catch (error) {
			appliedCoupon = null;
			if (couponMessageElement) couponMessageElement.textContent = error instanceof Error ? error.message : "El cupón no es válido.";
			renderSummary();
		} finally {
			if (applyCouponButton instanceof HTMLButtonElement) applyCouponButton.disabled = false;
		}
	});

	const loadOptions = async () => {
		const [shopSettings, zones] = await Promise.all([
			fetch(`${apiBase}/settings`).then((response) => response.json()).then((body) => body.data),
			hasPhysicalItems
				? fetch(`${apiBase}/delivery-zones`).then((response) => response.json()).then((body) => body.data)
				: Promise.resolve([]),
		]);
		settings = shopSettings;
		for (const zone of zones) {
			const option = document.createElement("option");
			option.value = zone.id;
			option.textContent = `${zone.name} — ${money(zone.deliveryCost)}`;
			zonesElement?.append(option);
		}
		for (const method of settings.paymentMethods) {
			const option = document.createElement("option");
			option.value = method;
			option.textContent = paymentMethodLabels[method] ?? method;
			paymentElement?.append(option);
		}
	};

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const data = new FormData(form);
		try {
			for (const entry of cart) {
				if (!entry.booking || entry.booking.reservationId) continue;
				const holdResponse = await fetch(`${apiBase}/reservations/hold`, {
					method: "POST",
					headers: { "Content-Type": "application/json", "X-EmDash-Request": "1" },
					body: JSON.stringify({ serviceId: entry.product.id, ...entry.booking, locale: "es" }),
				});
				const holdBody = await holdResponse.json();
				if (!holdResponse.ok) throw new Error(holdBody?.error?.message ?? "El horario ya no está disponible.");
				entry.booking = {
					reservationId: holdBody.data.id,
					startsAt: holdBody.data.startsAt,
					endsAt: holdBody.data.endsAt,
				};
			}
		if (messageElement) messageElement.textContent = "Creando tu pedido…";
		const customer = Object.fromEntries(customerFields.map((key) => [key, data.get(key)]));
			try {
				localStorage.setItem(customerStorageKey, JSON.stringify(customer));
			} catch {
				// Checkout should continue even when browser storage is unavailable.
			}
			const response = await fetch(`${apiBase}/orders`, {
				method: "POST",
				headers: { "Content-Type": "application/json", "X-EmDash-Request": "1" },
				body: JSON.stringify({
					items: cart.map((entry) => ({
						productId: entry.product.id,
						quantity: entry.quantity,
						...(typeof entry.variantId === "string" && entry.variantId ? { variantId: entry.variantId } : {}),
						...(entry.booking ? { booking: entry.booking } : {}),
					})),
					customer,
					deliveryZoneId: data.get("deliveryZoneId") || undefined,
					paymentMethod: data.get("paymentMethod"),
					couponCode: appliedCoupon?.code ?? undefined,
					notes: data.get("notes"),
				}),
			});
			const body = await response.json();
			if (!response.ok) throw new Error(body?.error?.message ?? "No se pudo crear el pedido.");
			localStorage.removeItem(storageKey);
			window.location.href = `/shop/thanks?order=${encodeURIComponent(body.data.orderNumber)}`;
		} catch (error) {
			if (messageElement) messageElement.textContent = error instanceof Error ? error.message : "No se pudo crear el pedido.";
		}
	});

	Promise.all([loadOptions(), Promise.resolve(renderSummary())]).catch((error) => {
		if (messageElement) messageElement.textContent = error instanceof Error ? error.message : "No se pudo cargar la compra.";
	});
</script>

<style>
	.checkout-page {
		max-width: 1000px;
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6);
	}

	.back-link { color: var(--color-text-secondary); text-decoration: none; }
	.checkout-page header { max-width: 680px; margin: var(--spacing-10) 0; }
	.eyebrow { color: var(--color-accent); font-size: var(--font-size-sm); font-weight: 700; text-transform: uppercase; }
	.checkout-page header p:last-child { color: var(--color-text-secondary); }
	.checkout-layout { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--spacing-8); }
	.checkout-summary, .checkout-form { padding: var(--spacing-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
	.checkout-summary p { padding: var(--spacing-3) 0; border-bottom: 1px solid var(--color-border); }
	.checkout-summary strong { display: block; margin-top: var(--spacing-6); font-size: var(--font-size-xl); }
	.checkout-form { display: grid; gap: var(--spacing-3); }
	.checkout-form [hidden] { display: none !important; }
	.checkout-form h2 { margin-bottom: var(--spacing-2); }
	.checkout-form label { display: grid; gap: var(--spacing-1); font-size: var(--font-size-sm); }
	.checkout-form input, .checkout-form select, .checkout-form textarea { width: 100%; padding: var(--spacing-3); border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-bg); color: var(--color-text); }
	.checkout-form textarea { min-height: 90px; }
	.checkout-form button { margin-top: var(--spacing-3); padding: var(--spacing-3); border: 0; border-radius: var(--radius); background: var(--color-accent); color: var(--color-on-accent); font-weight: 700; cursor: pointer; }
	.saved-customer { padding: var(--spacing-3); border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-bg); }
	.saved-customer p { margin: 0; color: var(--color-text-secondary); font-size: var(--font-size-sm); }
	.saved-customer-actions { display: flex; flex-wrap: wrap; gap: var(--spacing-2); margin-top: var(--spacing-2); }
	.saved-customer-actions button { margin-top: 0; }
	.saved-customer .secondary-button { background: var(--color-accent); color: var(--color-on-accent); }
	.saved-customer .text-button { background: transparent; color: var(--color-text-secondary); }
	#checkout-message { color: var(--color-accent); }
	@media (max-width: 760px) { .checkout-layout { grid-template-columns: 1fr; } }
</style>
