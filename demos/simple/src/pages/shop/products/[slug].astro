---
import { decodeSlug, getEmDashEntry, getSeoMeta } from "emdash";
import type { MediaValue, PortableTextBlock } from "emdash";
import { Image as ProductImage, PortableText } from "emdash/ui";
import Base from "../../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: product, cacheHint } = await getEmDashEntry("products", slug);

if (!product) {
	return Astro.redirect("/404");
}

Astro.cache.set(cacheHint);

const data = product.data as unknown as Record<string, unknown>;
const productId = typeof data.id === "string" ? data.id : product.id;
const name = typeof data.name === "string" ? data.name : "Producto";
type ProductTerm = { label?: unknown; slug?: unknown };
const terms = data.terms && typeof data.terms === "object" && !Array.isArray(data.terms)
	? (data.terms as Record<string, ProductTerm[]>)
	: {};
const categories = Array.isArray(terms.category)
	? terms.category.filter((term) => typeof term?.label === "string")
	: [];
const tags = Array.isArray(terms.tag)
	? terms.tag.filter((term) => typeof term?.label === "string")
	: [];
const richDescription = Array.isArray(data.rich_description)
	? (data.rich_description as PortableTextBlock[])
	: [];
const description = richDescription
	.flatMap((block) =>
		Array.isArray(block.children)
			? block.children.map((child) => (typeof child.text === "string" ? child.text : ""))
			: [],
	)
	.join(" ")
	.trim();
const rawPrice = typeof data.price === "number" ? data.price : Number(data.price);
const price = Number.isFinite(rawPrice) ? rawPrice : null;
const stock = typeof data.stock === "number" ? data.stock : null;
const promotionPrice =
	typeof data.promotion_price === "number" ? data.promotion_price : null;
const availability = data.availability_status;
const manuallyAvailable = availability !== "sold_out" && availability !== "hidden";
const featuredImage = data.featured_image as MediaValue | undefined;
const featuredImageUrl =
	typeof featuredImage?.src === "string"
		? featuredImage.src
		: typeof featuredImage?.meta?.storageKey === "string"
			? `/_emdash/api/media/file/${featuredImage.meta.storageKey}`
		: featuredImage?.id
			? `/_emdash/api/media/file/${featuredImage.id}`
			: undefined;
type ProductVariant = {
	label?: string;
	stock?: number;
	price?: number;
	image?: MediaValue;
};
const variants = Array.isArray(data.variants)
	? (data.variants as ProductVariant[]).filter((variant) => typeof variant.label === "string")
	: [];
const variantImageUrl = (variant?: ProductVariant) =>
	typeof variant?.image?.src === "string"
		? variant.image.src
		: typeof variant?.image?.meta?.storageKey === "string"
			? `/_emdash/api/media/file/${variant.image.meta.storageKey}`
			: variant?.image?.id
			? `/_emdash/api/media/file/${variant.image.id}`
			: featuredImageUrl;
const defaultPrice = promotionPrice !== null && price !== null && promotionPrice < price ? promotionPrice : price;
const initialPrice = price ?? defaultPrice;
const initialStock = stock;
const itemType = typeof data.item_type === "string" ? data.item_type.toLowerCase() : "";
const requiresBooking = data.requires_booking;
const isBookableService = itemType === "service" && (requiresBooking === true || requiresBooking === 1 || requiresBooking === "1" || requiresBooking === "true");
const isAvailable = manuallyAvailable && (isBookableService || stock === null || stock > 0);
const seo = getSeoMeta(product, {
	defaultTitle: name,
	defaultDescription: description || undefined,
	defaultOgImage: featuredImageUrl,
	path: `/shop/products/${slug}`,
});
---

<Base
	title={seo.title}
	description={seo.description}
	canonical={seo.canonical}
	content={{ collection: "products", id: product.id, slug }}
>
	<main class="product-page">
		<a class="back-link" href="/shop">← Volver a la tienda</a>
		<section class="product-card">
			<div class="product-image" data-product-image>
				{featuredImage ? <ProductImage id="product-image" image={featuredImage} alt={name} /> : <span>Imagen del producto</span>}
			</div>
			<div class="product-copy">
				{promotionPrice !== null && price !== null && promotionPrice < price && (
					<span class="promotion-label">Oferta</span>
				)}
				{(categories.length > 0 || tags.length > 0) && (
					<div class="product-taxonomies" aria-label="Categorías y etiquetas del producto">
						{categories.map((term) => <span class="taxonomy-badge">{term.label}</span>)}
						{tags.map((term) => <span class="taxonomy-badge taxonomy-badge--tag">#{term.label}</span>)}
					</div>
				)}
				<h1 {...product.edit.name}>{name}</h1>
				{variants.length > 0 && (
					<label class="variant-picker">
						<span>Elige una opción</span>
						<select
							id="product-variant-select"
							value=""
							data-base-price={initialPrice ?? ""}
							data-base-stock={initialStock ?? ""}
							data-base-image={featuredImageUrl ?? ""}
						>
							<option value="">Producto base</option>
							{variants.map((variant) => (
								<option
									value={variant.label}
									data-price={variant.price ?? initialPrice ?? ""}
									data-stock={variant.stock ?? initialStock ?? ""}
									data-image={variantImageUrl(variant)}
									disabled={variant.stock === 0}
								>
									{variant.label}
								</option>
							))}
						</select>
					</label>
				)}
				<div class="prices">
					{promotionPrice !== null && price !== null && promotionPrice < price && (
						<span class="old-price">S/ {price.toFixed(2)}</span>
					)}
					{initialPrice !== null && (
						<strong class="price" id="product-price">S/ {initialPrice.toFixed(2)}</strong>
					)}
				</div>
				{richDescription.length > 0 && (
					<div class="rich-description" {...product.edit.rich_description}>
						<PortableText value={richDescription} />
					</div>
				)}
				<p class:list={["availability", !isAvailable && "unavailable"]}>
					<span id="product-stock">{isBookableService ? (isAvailable ? "Cupos disponibles para reservar" : "No disponible actualmente") : variants.length > 0 ? `${initialStock ?? ""} disponibles para entrega` : isAvailable ? `${initialStock ?? ""} disponibles para entrega` : "No disponible actualmente"}</span>
				</p>
				{isBookableService && (
					<div class="booking-picker">
						<label for="booking-date">Fecha de reserva</label>
						<input id="booking-date" type="date" />
						<label for="booking-slot">Horario disponible</label>
						<select id="booking-slot" disabled>
							<option value="">Selecciona una fecha primero</option>
						</select>
						<p id="booking-message" role="status"></p>
					</div>
				)}
				<div class="quantity-picker" aria-label="Cantidad">
					<button id="decrease-quantity" type="button" disabled={!isAvailable}>−</button>
					<strong id="product-quantity">1</strong>
					<button id="increase-quantity" type="button" disabled={!isAvailable}>+</button>
				</div>
		<button id="add-product-to-cart" class="order-button" disabled={!isAvailable || isBookableService} type="button">
				{isBookableService ? "Reservar" : isAvailable ? "Agregar al pedido" : "Volver a la tienda"}
				</button>
			</div>
		</section>
		<section class="related-products" id="related-products" hidden aria-labelledby="related-products-title">
			<h2 id="related-products-title">También te puede interesar</h2>
			<div class="related-products-grid" id="related-products-grid"></div>
		</section>
	</main>
</Base>

<script type="application/json" id="product-payload" set:html={JSON.stringify({ id: productId, slug, data, isBookableService }).replace(/</g, "\\u003c")} />

<script>
	const cartStorageKey = "emdash-shop-cart";
	const payloadElement = document.querySelector("#product-payload");
	const addButton = document.querySelector("#add-product-to-cart");
	const decreaseQuantity = document.querySelector("#decrease-quantity");
	const increaseQuantity = document.querySelector("#increase-quantity");
	const quantityElement = document.querySelector("#product-quantity");
	const select = document.querySelector("#product-variant-select");
	const price = document.querySelector("#product-price");
	const stock = document.querySelector("#product-stock");
	const imageContainer = document.querySelector("[data-product-image]");
	const relatedSection = document.querySelector("#related-products");
	const relatedGrid = document.querySelector("#related-products-grid");
	const bookingDate = document.querySelector("#booking-date");
	const bookingSlot = document.querySelector("#booking-slot");
	const bookingMessage = document.querySelector("#booking-message");
	const payload = payloadElement?.textContent ? JSON.parse(payloadElement.textContent) : null;
	const basePrice = select instanceof HTMLSelectElement ? select.dataset.basePrice : "";
	const baseStock = select instanceof HTMLSelectElement ? select.dataset.baseStock : "";
	const baseImage = select instanceof HTMLSelectElement ? select.dataset.baseImage ?? "" : "";
	let quantity = 1;

	const updateImage = (source: string, alt = "Imagen del producto") => {
		if (!imageContainer) return;
		if (source) {
			let image = imageContainer.querySelector("img");
			if (!image) {
				image = document.createElement("img");
				imageContainer.replaceChildren(image);
			}
				image.alt = alt;
				image.removeAttribute("srcset");
				image.removeAttribute("sizes");
				image.src = source;
		} else if (!imageContainer.querySelector("img")) {
			imageContainer.textContent = "Imagen del producto";
		}
	};

	const getSelectedVariant = () => {
		if (!(select instanceof HTMLSelectElement)) return null;
		const option = select.selectedOptions[0];
		if (!option || !option.value) return null;
		return {
			id: option.value,
			label: option.value,
			stock: option.dataset.stock ? Number(option.dataset.stock) : null,
			price: option.dataset.price ? Number(option.dataset.price) : null,
		};
	};

	const getStockLimit = () => {
		const variant = getSelectedVariant();
		if (variant?.stock !== null && variant?.stock !== undefined) return variant.stock;
		return baseStock === "" ? null : Number(baseStock);
	};

	const updateQuantity = () => {
		const stockLimit = getStockLimit();
		if (stockLimit !== null) quantity = Math.min(quantity, Math.max(stockLimit, 1));
		if (quantityElement) quantityElement.textContent = String(quantity);
		if (decreaseQuantity instanceof HTMLButtonElement) decreaseQuantity.disabled = quantity <= 1;
		if (increaseQuantity instanceof HTMLButtonElement) increaseQuantity.disabled = stockLimit !== null && quantity >= stockLimit;
	};

	decreaseQuantity?.addEventListener("click", () => {
		quantity = Math.max(1, quantity - 1);
		updateQuantity();
	});
	increaseQuantity?.addEventListener("click", () => {
		const stockLimit = getStockLimit();
		if (stockLimit === null || quantity < stockLimit) quantity += 1;
		updateQuantity();
	});

	const loadBookingSlots = async () => {
		if (!(payload?.isBookableService && bookingDate instanceof HTMLInputElement && bookingSlot instanceof HTMLSelectElement)) return;
		bookingSlot.replaceChildren();
		bookingSlot.disabled = true;
		if (addButton instanceof HTMLButtonElement) addButton.disabled = true;
		if (!bookingDate.value) {
			bookingSlot.append(new Option("Selecciona una fecha primero", ""));
			return;
		}
		if (bookingMessage) bookingMessage.textContent = "Cargando horarios…";
		try {
			const response = await fetch(`/_emdash/api/shop/services/${encodeURIComponent(payload.id)}/availability?date=${encodeURIComponent(bookingDate.value)}&locale=es`);
			const body = await response.json();
			if (!response.ok) throw new Error(body?.error?.message ?? "No se pudo cargar la disponibilidad.");
			const slots = Array.isArray(body.data) ? body.data : [];
			if (slots.length === 0) bookingSlot.append(new Option("No hay horarios disponibles", ""));
			for (const slot of slots) {
				const start = new Date(slot.startsAt);
				const end = new Date(slot.endsAt);
				bookingSlot.append(new Option(`${start.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", timeZone: "UTC" })} – ${end.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", timeZone: "UTC" })}`, JSON.stringify({ startsAt: slot.startsAt, endsAt: slot.endsAt })));
			}
			bookingSlot.disabled = slots.length === 0;
			if (bookingMessage) bookingMessage.textContent = slots.length ? "Selecciona un horario." : "No hay horarios para esta fecha.";
		} catch (error) {
			bookingSlot.append(new Option("No se pudo cargar", ""));
			if (bookingMessage) bookingMessage.textContent = error instanceof Error ? error.message : "No se pudo cargar la disponibilidad.";
		}
	};
	bookingDate?.addEventListener("change", loadBookingSlots);
	const syncBookingButton = () => {
		if (addButton instanceof HTMLButtonElement) {
			addButton.disabled = !(bookingSlot instanceof HTMLSelectElement && bookingSlot.value);
		}
	};
	bookingSlot?.addEventListener("change", syncBookingButton);
	bookingSlot?.addEventListener("input", syncBookingButton);

	addButton?.addEventListener("click", async () => {
		if (!payload) return;
		let booking = null;
		if (payload.isBookableService) {
			if (!(bookingSlot instanceof HTMLSelectElement) || !bookingSlot.value) return;
			const selected = JSON.parse(bookingSlot.value);
			booking = selected;
			if (addButton instanceof HTMLButtonElement) addButton.disabled = true;
			if (payload.isBookableService && booking?.reservationId) try {
				const response = await fetch("/_emdash/api/shop/reservations/hold", { method: "POST", headers: { "Content-Type": "application/json", "X-EmDash-Request": "1" }, body: JSON.stringify({ serviceId: payload.id, ...selected, locale: "es" }) });
				const body = await response.json();
				if (!response.ok) throw new Error(body?.error?.message ?? "El horario ya no está disponible.");
				booking = { reservationId: body.data.id, startsAt: body.data.startsAt, endsAt: body.data.endsAt };
			} catch (error) {
				if (bookingMessage) bookingMessage.textContent = error instanceof Error ? error.message : "El horario ya no está disponible.";
				if (addButton instanceof HTMLButtonElement) addButton.disabled = false;
				return;
			}
		}
		const variant = getSelectedVariant();
		const key = `${payload.id}:${variant?.id ?? ""}:${booking?.startsAt ?? ""}`;
		let cart = [];
		try {
			const stored = JSON.parse(localStorage.getItem(cartStorageKey) ?? "[]");
			if (Array.isArray(stored)) cart = stored;
		} catch {
			cart = [];
		}
		try {
			const existing = cart.find((entry) => entry?.key === key);
			const stockLimit = payload.isBookableService ? null : variant?.stock ?? (typeof payload.data.stock === "number" ? payload.data.stock : null);
			const currentQuantity = existing?.quantity ?? 0;
			if (stockLimit !== null && currentQuantity + quantity > stockLimit) return;
			if (existing) {
				existing.quantity = payload.isBookableService ? 1 : currentQuantity + quantity;
				if (payload.isBookableService) existing.booking = booking;
			}
			else cart.push({ key, product: payload, variantId: variant?.id ?? null, quantity, booking });
			localStorage.setItem(cartStorageKey, JSON.stringify(cart));
			if (addButton instanceof HTMLButtonElement) addButton.textContent = booking ? "Redirigiendo al checkout…" : "Agregado al pedido";
			window.location.assign(booking ? "/shop/checkout" : "/shop");
		} catch (error) {
			if (bookingMessage) bookingMessage.textContent = error instanceof Error ? error.message : "No se pudo guardar la reserva en el carrito.";
			if (addButton instanceof HTMLButtonElement) addButton.disabled = false;
		}
	});

	if (select instanceof HTMLSelectElement) {
		select.addEventListener("change", () => {
			const option = select.selectedOptions[0];
			if (!option) return;
			const selectedVariant = getSelectedVariant();
			const optionPrice = option.dataset.price;
			const optionStock = option.dataset.stock;
			const optionImage = option.dataset.image;
			if (price) {
				const displayedPrice = selectedVariant ? optionPrice : basePrice;
				if (displayedPrice) price.textContent = `S/ ${Number(displayedPrice).toFixed(2)}`;
			}
			if (stock) {
				const displayedStock = selectedVariant ? optionStock : baseStock;
				stock.textContent = displayedStock ? `${displayedStock} disponibles para entrega` : "Disponible para entrega";
			}
			if (addButton instanceof HTMLButtonElement) {
				const available = selectedVariant
					? (selectedVariant.stock === null || selectedVariant.stock > 0)
					: baseStock === "" || Number(baseStock) > 0;
				addButton.disabled = !available;
				addButton.textContent = available ? "Agregar al pedido" : "No disponible actualmente";
				if (decreaseQuantity instanceof HTMLButtonElement) decreaseQuantity.disabled = !available || quantity <= 1;
				if (increaseQuantity instanceof HTMLButtonElement) increaseQuantity.disabled = !available || (selectedVariant?.stock ?? (baseStock === "" ? null : Number(baseStock))) === quantity;
			}
			updateQuantity();
			updateImage(selectedVariant ? (optionImage ?? "") : baseImage, selectedVariant ? "Variación del producto" : "Imagen del producto");
		});
	}

	const loadRelatedProducts = async () => {
		if (!(relatedSection instanceof HTMLElement) || !(relatedGrid instanceof HTMLElement) || !payload?.id) return;
		try {
			const response = await fetch(`/_emdash/api/shop/products/${encodeURIComponent(payload.id)}/related?limit=4`);
			if (!response.ok) return;
			const body = await response.json();
			const products = Array.isArray(body?.data) ? body.data : [];
			for (const item of products) {
				const productData = item?.data;
				if (!productData || typeof productData.name !== "string" || typeof item.slug !== "string") continue;
				const link = document.createElement("a");
				link.className = "related-product";
				link.href = `/shop/products/${encodeURIComponent(item.slug)}`;
				const image = productData.featured_image;
				const imageUrl = typeof image?.src === "string" ? image.src : typeof image?.id === "string" ? `/_emdash/api/media/file/${image.id}` : "";
				if (imageUrl) {
					const imageElement = document.createElement("img");
					imageElement.src = imageUrl;
					imageElement.alt = productData.name;
					imageElement.loading = "lazy";
					link.append(imageElement);
				}
				const name = document.createElement("strong");
				name.textContent = productData.name;
				link.append(name);
				if (typeof productData.price === "number") {
					const priceElement = document.createElement("span");
					priceElement.textContent = `S/ ${productData.price.toFixed(2)}`;
					link.append(priceElement);
				}
				relatedGrid.append(link);
			}
			if (relatedGrid.childElementCount > 0) relatedSection.hidden = false;
		} catch {
			return;
		}
	};
	void loadRelatedProducts();
</script>

<style>
	.product-page {
		max-width: 900px;
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6);
	}

	.back-link {
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.back-link:hover {
		color: var(--color-text);
	}

	.product-card {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
		gap: clamp(var(--spacing-6), 5vw, var(--spacing-12));
		align-items: start;
		margin-top: var(--spacing-10);
		padding: clamp(var(--spacing-4), 5vw, var(--spacing-10));
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
	}

	.product-image {
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 1 / 1;
		min-height: 0;
		margin-bottom: 0;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-bg-subtle);
		color: var(--color-muted);
	}

	.product-image :global(img) {
		width: 100%;
		height: 100%;
		max-height: 460px;
		object-fit: cover;
	}

	.product-copy {
		max-width: 680px;
		padding-top: var(--spacing-2);
	}

	.promotion-label {
		display: inline-block;
		margin-bottom: var(--spacing-3);
		color: var(--color-accent);
		font-size: var(--font-size-sm);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
	}

	.product-taxonomies {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		margin-bottom: var(--spacing-3);
	}

	.taxonomy-badge {
		padding: var(--spacing-1) var(--spacing-2);
		border-radius: var(--radius);
		background: var(--color-bg-subtle);
		color: var(--color-text-secondary);
		font-size: var(--font-size-sm);
	}

	.taxonomy-badge--tag {
		background: var(--color-accent-subtle);
		color: var(--color-accent);
	}

	h1 {
		margin-bottom: var(--spacing-5);
		font-size: clamp(2rem, 5vw, var(--font-size-5xl));
	}

	.prices {
		display: flex;
		align-items: baseline;
		gap: var(--spacing-3);
		margin-bottom: var(--spacing-6);
	}

	.variant-picker {
		display: grid;
		gap: var(--spacing-2);
		margin-bottom: var(--spacing-6);
		color: var(--color-text-secondary);
		font-size: var(--font-size-sm);
		font-weight: 600;
	}

	.variant-picker select {
		padding: var(--spacing-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg);
		color: var(--color-text);
		font: inherit;
	}

	.price {
		font-size: var(--font-size-2xl);
	}

	.old-price {
		color: var(--color-muted);
		text-decoration: line-through;
	}

	.base-price {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.rich-description {
		color: var(--color-text-secondary);
		line-height: var(--leading-relaxed);
	}

	.rich-description {
		margin-top: var(--spacing-6);
	}

	.related-products {
		margin-top: var(--spacing-12);
	}

	.related-products h2 {
		margin-bottom: var(--spacing-5);
		font-size: var(--font-size-2xl);
	}

	.related-products-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
		gap: var(--spacing-4);
	}

	.related-product {
		display: grid;
		gap: var(--spacing-2);
		padding: var(--spacing-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		color: var(--color-text);
		text-decoration: none;
	}

	.related-product:hover {
		border-color: var(--color-accent);
	}

	.related-product img {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: var(--radius-sm);
		background: var(--color-bg-subtle);
	}

	.related-product span {
		color: var(--color-text-secondary);
		font-size: var(--font-size-sm);
	}

	.availability {
		margin: var(--spacing-8) 0 var(--spacing-5);
		color: var(--color-accent);
		font-size: var(--font-size-sm);
		font-weight: 600;
	}

	.availability.unavailable {
		color: var(--color-muted);
	}

	.quantity-picker {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-3);
		margin-bottom: var(--spacing-5);
	}

	.quantity-picker button {
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg);
		color: var(--color-text);
		font-size: var(--font-size-lg);
		cursor: pointer;
	}

	.quantity-picker button:disabled {
		cursor: not-allowed;
		opacity: 0.45;
	}

